{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PayrollManager",
  "version": "0.1.0",
  "identifier": "com.payrollmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run bundle:sidecar -- --if-missing && npm run sidecar:build && npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run bundle:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PayrollManager",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": ["binaries/payroll-backend"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
